{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wallet-platform.local/events/TransferCompleted.v1.schema.json",
  "title": "TransferCompleted",
  "description": "Transfer booked: the sender was debited and the recipient credited (minus the fee).",
  "x-event-type": "TransferCompleted",
  "x-event-version": 1,
  "x-topic": "wallet.transfer",
  "x-key": "aggregate id, as a decimal string",
  "type": "object",
  "required": [
    "id",
    "createdAt",
    "updatedAt",
    "fromAccountId",
    "toAccountId",
    "amount",
    "currency",
    "status",
    "failureReason"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "fromAccountId": {
      "type": "integer",
      "minimum": 1,
      "description": "Id of another wallet aggregate"
    },
    "toAccountId": {
      "type": "integer",
      "minimum": 1,
      "description": "Id of another wallet aggregate"
    },
    "amount": {
      "type": "integer",
      "minimum": 1,
      "description": "Minor units (cents)"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 code"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "COMPLETED",
        "FAILED",
        "REVERSED"
      ]
    },
    "failureReason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true,
  "examples": [
    {
      "id": 11,
      "createdAt": "2026-10-11T08:49:42.695Z",
      "updatedAt": "2026-10-11T08:49:43.120Z",
      "fromAccountId": 7,
      "toAccountId": 9,
      "amount": 250,
      "currency": "EUR",
      "status": "COMPLETED",
      "failureReason": null
    }
  ]
}
