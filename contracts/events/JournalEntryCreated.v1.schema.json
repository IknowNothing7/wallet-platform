{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wallet-platform.local/events/JournalEntryCreated.v1.schema.json",
  "title": "JournalEntryCreated",
  "description": "A ledger journal entry was written.",
  "x-event-type": "JournalEntryCreated",
  "x-event-version": 1,
  "x-topic": "wallet.journal_entry",
  "x-key": "aggregate id, as a decimal string",
  "type": "object",
  "required": [
    "id",
    "createdAt",
    "entryType",
    "description",
    "referenceType",
    "referenceId",
    "postings"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "entryType": {
      "type": "string",
      "enum": [
        "TRANSFER",
        "DEPOSIT",
        "WITHDRAWAL",
        "FEE",
        "HOLD_CAPTURE",
        "HOLD_RELEASE",
        "REVERSAL"
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "referenceType": {
      "type": [
        "string",
        "null"
      ]
    },
    "referenceId": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "Id of another wallet aggregate"
    },
    "postings": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/posting"
      },
      "description": "Not filled in this event; postings follow in PostingsCreated"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "posting": {
      "type": "object",
      "required": [
        "id",
        "journalEntryId",
        "accountId",
        "direction",
        "amount",
        "currency",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "journalEntryId": {
          "type": "integer",
          "minimum": 1,
          "description": "Id of another wallet aggregate"
        },
        "accountId": {
          "type": "integer",
          "minimum": 1,
          "description": "Id of another wallet aggregate"
        },
        "direction": {
          "type": "string",
          "enum": [
            "DEBIT",
            "CREDIT"
          ]
        },
        "amount": {
          "type": "integer",
          "minimum": 1,
          "description": "Minor units (cents)"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    }
  },
  "examples": [
    {
      "id": 31,
      "createdAt": "2026-10-11T08:49:42.695Z",
      "entryType": "HOLD_CAPTURE",
      "description": null,
      "referenceType": "hold",
      "referenceId": 5,
      "postings": null
    }
  ]
}
