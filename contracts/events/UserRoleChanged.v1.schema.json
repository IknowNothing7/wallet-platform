{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wallet-platform.local/events/UserRoleChanged.v1.schema.json",
  "title": "UserRoleChanged",
  "description": "An admin changed a user's role (PUT /api/users/{id}/role); the payload carries the new one. Only USER and MERCHANT are ever set this way. No PII, like UserCreated.",
  "x-event-type": "UserRoleChanged",
  "x-event-version": 1,
  "x-topic": "wallet.user",
  "x-key": "aggregate id, as a decimal string",
  "type": "object",
  "required": [
    "id",
    "createdAt",
    "updatedAt",
    "role"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "role": {
      "type": "string",
      "enum": [
        "USER",
        "ADMIN",
        "MERCHANT"
      ]
    }
  },
  "additionalProperties": true,
  "examples": [
    {
      "id": 3,
      "createdAt": "2026-10-11T08:49:42.695Z",
      "updatedAt": "2026-10-18T10:02:13.120Z",
      "role": "MERCHANT"
    }
  ]
}
